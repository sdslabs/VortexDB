# HTTP Server
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# gRPC Server
GRPC_HOST=127.0.0.1
GRPC_PORT=50051

# API keys used by both the HTTP and gRPC servers (required)
# See keys.example.json for the file format
VORTEXDB_KEYS_FILE=./keys.json

# Database Configuration
# Storage: inmemory, rocksdb
# Index: flat, kdtree, hnsw
STORAGE_TYPE=rocksdb 
INDEX_TYPE=flat
DIMENSION=512
SIMILARITY=cosine

DATA_PATH=./data

# Server Options
LOGGING=true
DISABLE_HTTP=false

# Embedding Services (TUI)
TEXT_EMBEDDING_URL=http://localhost:8080/vectors
IMAGE_EMBEDDING_URL=http://localhost:8080/vectors_img
